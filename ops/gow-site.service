[Unit]
Description=Mise à jour de Games on Web 2027
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gow-deploy
StateDirectory=gow-site
StateDirectoryMode=0755
UMask=0022
ExecStart=/usr/bin/python3 /usr/local/lib/gow-site/update.py
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
