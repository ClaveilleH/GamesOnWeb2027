root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,sh,conf}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Diffs patch-package : à laisser tels quels.
[*.patch]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
